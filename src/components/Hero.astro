---
import BlinkCursor from "@components/BlinkCursor.astro";
import CtaLink from "@components/CtaLink.astro";
import MatrixText from "@components/MatrixText.astro";
import type { Cta } from "../types/section.types";

const hasCtaLink = (cta: Cta) => Boolean(cta.link?.trim());

export type HeroProps = {
  title: string;
  subtitle: string;
  cta?: Cta;
};
const { hero } = Astro.props as { hero: HeroProps };
const { title, subtitle, cta } = hero;
---

<section id="hero" class="container">
  <header>
    <h1 class="color"><MatrixText text={title} /></h1>
  </header>
  <main>
    <p>{subtitle}</p>
  </main>
  {
    cta && (
      <footer>
        {hasCtaLink(cta) ? (
          <CtaLink cta={cta} />
        ) : (
          <span class="cta-highlight">
            {cta.text}
            <BlinkCursor />
          </span>
        )}
      </footer>
    )
  }
</section>
